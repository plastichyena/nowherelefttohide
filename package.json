{
  "name": "nowhere-left-to-hide",
  "version": "1.3.3",
  "private": true,
  "description": "Nowhere Left to Hide - a mobile-first hex strategy game PoC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:random": "vite-node --script src/agent/sim-cli.ts --agent=random --out=output/simulations/random-smoke --overwrite",
    "test:balanced": "vite-node --script src/agent/sim-cli.ts --agent=balanced --out=output/simulations/balanced-smoke --overwrite",
    "test:browser-bridge": "vite-node --script src/testing/browser-bridge-smoke.ts",
    "sim": "vite-node --script src/agent/sim-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
